#!/usr/bin/env bash
# Disk I/O pressure (Linux PSI) and the app writing the most.
. "${WHISKERS_LIB:?}/common.sh"
DESCRIBE='{"name":"Disk activity","description":"Tells you when apps are stuck waiting for the disk, and which app is writing the most.","applies":'"$([[ -r /proc/pressure/io ]] && echo true || echo false)"',"default_enabled":true,
 "options":[{"key":"pressure_warn","type":"int","default":30,"min":5,"max":100,"label":"Warn when apps wait more than","unit":"% of a minute"}]}'

run() {
  local full top mbs pid comm who=""
  full=$(awk '/^full/{ for (i=1;i<=NF;i++) if ($i ~ /^avg60=/) { sub("avg60=","",$i); printf "%d", $i } }' /proc/pressure/io)
  top=$(ps -u "$(id -u)" -o pid=,etimes=,comm= 2>/dev/null | while read -r pid et comm; do
          (( et > 60 )) || continue
          wb=$(awk '/^write_bytes/{print $2}' "/proc/$pid/io" 2>/dev/null) || continue
          [[ -n $wb ]] && echo "$((wb / et / 1048576)) $pid $comm"
        done | sort -rn | head -n 1)
  if [[ -n $top ]]; then
    read -r mbs pid comm <<<"$top"
    (( mbs >= 1 )) && who="$(friendly_name "$comm") (pid $pid) writes about $mbs MB/s"
  fi
  if (( full >= $(opt pressure_warn 30) )); then
    emit io warn "Your apps are waiting on the disk" \
      "For $full% of the last minute, programs were stuck waiting for the drive, which feels like lag or freezing.${who:+ Biggest writer: $who.}" \
      "Close or pause the biggest writer. Live view: watch -n2 cat /proc/pressure/io"
  else
    emit io ok "Disk activity" "The disk is keeping up ($full% waiting).${who:+ Biggest writer: $who.}"
  fi
}
plugin_main "$@"
