[Icon Theme]
Name=Thumbs & Paws
Comment=One Man Nine Lives icons: warm tabby folders with cat ears. Anything not drawn yet comes from Breeze.
Inherits=breeze,hicolor
Example=folder
DisplayDepth=32
FollowsColorScheme=true
Directories=places/16,places/22,places/scalable,apps/16,apps/22,apps/scalable,actions/16,actions/22,actions/scalable,devices/16,devices/22,devices/scalable

[places/16]
Size=16
Context=Places
Type=Fixed

[places/22]
Size=22
Context=Places
Type=Fixed

[places/scalable]
Size=64
MinSize=32
MaxSize=512
Type=Scalable
Context=Places

[apps/16]
Size=16
Context=Applications
Type=Fixed

[apps/22]
Size=22
Context=Applications
Type=Fixed

[apps/scalable]
Size=64
MinSize=32
MaxSize=512
Type=Scalable
Context=Applications

[actions/16]
Size=16
Context=Actions
Type=Fixed

[actions/22]
Size=22
Context=Actions
Type=Fixed

[actions/scalable]
Size=64
MinSize=32
MaxSize=512
Type=Scalable
Context=Actions

[devices/16]
Size=16
Context=Devices
Type=Fixed

[devices/22]
Size=22
Context=Devices
Type=Fixed

[devices/scalable]
Size=64
MinSize=32
MaxSize=512
Type=Scalable
Context=Devices
